{
  "name": "app-elysia",
  "version": "0.0.45",
  "type": "module",
  "scripts": {
    "menu": "bun ./support/script/menu.ts",
    "dev": "bun --parallel run watch_generate_script watch_dev",
    "build": "bun run generate_script && bun build ./app/cluster.ts --outdir=dist --target=bun --external @prisma/client --external mariadb --external @prisma/adapter-mariadb",
    "start": "NODE_ENV=production bun --hot ./app/cluster.ts",
    "start-hot": "NODE_ENV=production bun --hot ./app/cluster.ts",
    "start-hot-bg": "NODE_ENV=production bun --hot --background ./app/cluster.ts",
    "fix": "bunx --bun @biomejs/biome check --write .",
    "watch_dev": "bun --watch ./app/cluster.ts",
    "watch_generate_script": "bun ./support/script/index.ts watch",
    "generate": "bun --parallel 'generate_*'",
    "generate_script": "bun ./support/script/index.ts",
    "prisma_generate": "bunx --bun prisma generate",
    "generate_prisma_migrate_dev": "bunx --bun prisma migrate dev --name init",
    "prisma_generate_migrate_deploy": "bunx --bun prisma migrate deploy && bunx --bun prisma generate",
    "prisma_studio": "bunx --bun prisma studio"
  },
  "dependencies": {
    "@elysia/eden": "1.4.10",
    "@elysia/openapi": "1.4.15",
    "@elysia/static": "1.4.10",
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "elysia": "1.4.28",
    "mariadb": "^3.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "bun-types": "1.3.13",
    "prisma": "^7.8.0"
  }
}

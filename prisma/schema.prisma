generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// 账号角色，当前仅支持管理员和作者。
enum UserRole {
  /// 系统管理员。
  ADMIN
  /// 网文作者。
  AUTHOR
}

/// 账号状态，用于鉴权和软删除。
enum UserStatus {
  /// 正常可用。
  ACTIVE
  /// 已封禁。
  BANNED
  /// 已软删除。
  DELETED
}

/// 作品类型。
enum NovelType {
  /// 小说。
  NOVEL
  /// 剧本。
  SCRIPT
}

/// 提示词隐私设置。
enum PromptPrivacy {
  /// 仅自用。
  PRIVATE
  /// 公开共享。
  SHARED
  /// 授权访问。
  AUTHORIZED
}

/// 用户账号主体。
model User {
  /// 自增主键。
  id            Int            @id @default(autoincrement())
  /// 用户名，登录标识之一。
  username      String         @unique @db.VarChar(64)
  /// 邮箱，登录标识之一。
  email         String         @unique @db.VarChar(255)
  /// Argon2id 密码哈希。
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  /// 账号角色。
  role          UserRole       @default(AUTHOR)
  /// 账号状态。
  status        UserStatus     @default(ACTIVE)
  /// 令牌版本号，修改密码或封禁时自增，使已签发的 JWT 立即失效。
  tokenVersion  Int            @default(1) @map("token_version")
  /// 最后登录时间。
  lastLoginAt   DateTime?      @map("last_login_at")
  /// 创建时间。
  createdAt     DateTime       @default(now()) @map("created_at")
  /// 更新时间。
  updatedAt     DateTime       @updatedAt @map("updated_at")
  /// 账号拥有的刷新令牌。
  refreshTokens RefreshToken[]
  /// 用户创建的小说作品。
  novelBooks      NovelBook[]
  /// 用户创建的提示词模板。
  promptTemplates PromptTemplate[]

  @@map("users")
}

/// 刷新令牌，只保存不可逆哈希。
model RefreshToken {
  /// 自增主键。
  id        Int       @id @default(autoincrement())
  /// 所属用户 ID。
  userId    Int       @map("user_id")
  /// 刷新令牌 SHA-256 哈希。
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// 令牌族，用于复用检测和批量撤销。
  family    String    @db.Char(36)
  /// 过期时间。
  expiresAt DateTime  @map("expires_at")
  /// 撤销时间。
  revokedAt DateTime? @map("revoked_at")
  /// 创建时间。
  createdAt DateTime  @default(now()) @map("created_at")
  /// 所属用户。
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// 小说作品。
model NovelBook {
  /// 自增主键。
  id          Int           @id @default(autoincrement())
  /// 所属作者用户 ID。
  userId      Int           @map("user_id")
  /// 作品名称。
  name        String        @db.VarChar(255)
  /// 作品简介。
  description String?       @db.Text
  /// 作品类型。
  type        NovelType?
  /// 累计字数。
  totalWords  Int           @default(0) @map("total_words")
  /// 排序序号。
  order       Int           @default(0)
  /// 是否归档。
  archived    Boolean       @default(false)
  /// 是否回收站。
  isTrash     Boolean       @default(false) @map("is_trash")
  /// 创建时间。
  createdAt   DateTime      @default(now()) @map("created_at")
  /// 更新时间。
  updatedAt   DateTime      @updatedAt @map("updated_at")
  /// 所属作者。
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 作品下的章节。
  chapters    NovelChapter[]

  @@index([userId])
  @@map("novel_books")
}

/// 小说章节。
model NovelChapter {
  /// 自增主键。
  id        Int       @id @default(autoincrement())
  /// 所属作品 ID。
  bookId    Int       @map("book_id")
  /// 章节标题。
  title     String    @db.VarChar(500)
  /// 章节正文（压缩加密后的二进制）。
  content   Bytes?    @db.LongBlob
  /// 章节排序序号。
  order     Int       @default(0)
  /// 字数统计。
  wordCount Int       @default(0) @map("word_count")
  /// 创建时间。
  createdAt DateTime  @default(now()) @map("created_at")
  /// 更新时间。
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// 所属作品。
  book      NovelBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("novel_chapters")
}

/// 提示词模板。
model PromptTemplate {
  /// 自增主键。
  id            Int            @id @default(autoincrement())
  /// 创建者用户 ID。
  userId        Int            @map("user_id")
  /// 提示词名称。
  name          String         @db.VarChar(255)
  /// 提示词内容（支持变量占位）。
  content       String         @db.Text
  /// 预制输入选项（JSON 数组）。
  presetOptions Json?          @map("preset_options")
  /// 提示词介绍。
  description   String?        @db.Text
  /// 隐私设置。
  privacy       PromptPrivacy  @default(PRIVATE)
  /// 使用方法（简短说明）。
  usageGuide    String?        @map("usage_guide") @db.VarChar(500)
  /// 是否通过审核。
  isApproved    Boolean        @default(false) @map("is_approved")
  /// 是否软删除。
  isDeleted     Boolean        @default(false) @map("is_deleted")
  /// 创建时间。
  createdAt     DateTime       @default(now()) @map("created_at")
  /// 更新时间。
  updatedAt     DateTime       @updatedAt @map("updated_at")
  /// 创建者。
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 历史版本。
  versions      PromptTemplateVersion[]

  @@index([userId])
  @@index([privacy])
  @@index([isApproved])
  @@index([isDeleted])
  @@map("prompt_templates")
}

/// 提示词历史版本快照。
model PromptTemplateVersion {
  /// 自增主键。
  id               Int       @id @default(autoincrement())
  /// 所属提示词 ID。
  promptTemplateId Int       @map("prompt_template_id")
  /// 版本号。
  version          Int
  /// 提示词名称快照。
  name             String    @db.VarChar(255)
  /// 提示词内容快照。
  content          String    @db.Text
  /// 预制输入选项快照（JSON 数组）。
  presetOptions    Json?     @map("preset_options")
  /// 提示词介绍快照。
  description      String?   @db.Text
  /// 使用方法快照。
  usageGuide       String?   @map("usage_guide") @db.VarChar(500)
  /// 变更说明。
  changeNote       String?   @map("change_note") @db.VarChar(500)
  /// 快照创建时间。
  createdAt        DateTime  @default(now()) @map("created_at")
  /// 所属提示词。
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@index([promptTemplateId, version])
  @@map("prompt_template_versions")
}
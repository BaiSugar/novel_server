# ----------------- 服务配置 -----------------
# 端口
PORT=4000
# 开发日志开关，设为 false 关闭
DEV_LOG=true

# ----------------- 单机多进程集群模式配置 -----------------
# 是否启用集群模式，默认关闭
# CLUSTER_ENABLED=true
# worker 进程数量，默认 CPU 核心数，至少 1
# CLUSTER_WORKERS=4
# worker 崩溃后重启延迟（毫秒），默认 1000
# CLUSTER_RESTART_DELAY=1000
# 时间窗口内允许的最大重启次数, 默认 5，超过则熔断
# CLUSTER_MAX_RESTARTS=5
# 重启计数的统计时间窗口（毫秒）, 默认 60000
# CLUSTER_RESTART_WINDOW=60000

# ----------------- 数据库配置 -----------------
# 类型
DATABASE_TYPE="mysql"
# IP
DATABASE_HOST="127.0.0.1"
# 端口
DATABASE_PORT="3306"
# 库名
DATABASE_NAME="novel"
# 用户
DATABASE_USER="root"
# 密码
DATABASE_PASSWORD="123456"
# 数据库连接串由 `app/config/database.ts` 基于上方分项配置生成，避免 .env 变量嵌套在不同运行入口表现不一致
# Shadow Database (用于 Prisma Migrate 等数据库迁移操作的临时数据库)
DATABASE_SHADOW_NAME="novel_shadow"

# ----------------- 认证配置 -----------------
JWT_SECRET="tIF5xZAruKMFVaN0CUCFxgffemmQRrHcfGAowPZ1FR2CR0dvJCUYEXsAdpOEy6y7"
# 章节正文落库前压缩加密使用的 32 字节 base64 密钥
CHAPTER_ENCRYPTION_KEY="smiqzPaYEnIu8iGfZAsuOrY3UNgE14R/c6f4aiQ3xxU="
ACCESS_TOKEN_EXPIRES_IN=1296000
REFRESH_TOKEN_EXPIRES_IN=2592000

# ----------------- 首次启动管理员配置 -----------------
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@test.com"
BOOTSTRAP_ADMIN_PASSWORD="12345678"

# ----------------- AI 配置 -----------------
# Provider API Key 加密使用的 32 字节 base64 密钥（开发环境可与章节密钥分离后替换）
AI_PROVIDER_KEY_SECRET="smiqzPaYEnIu8iGfZAsuOrY3UNgE14R/c6f4aiQ3xxU="
AI_HEALTH_WINDOW_SIZE=50
AI_LATENCY_SOFT_LIMIT_MS=3000
AI_LATENCY_HARD_LIMIT_MS=5000
AI_HEAD_WINDOW=3
AI_CIRCUIT_BASE_MS=60000
AI_IMAGE_DEFAULT_SIZE="1024x1024"
AI_IMAGE_DEFAULT_QUALITY="standard"

# ----------------- Redis 配置 -----------------
# REDIS_URL=""

# ----------------- 前端配置 -----------------
# 前端源地址，用于 CORS 跨域白名单。配合前端被动 token 刷新。
FRONTEND_ORIGIN="http://localhost:3000"